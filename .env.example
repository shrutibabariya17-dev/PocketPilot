# PocketPilot Environment Configuration Template
# Copy this file to .env and customize for your deployment environment.
# Example: cp .env.example .env

# Application Environment ('production' or 'development')
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹

# Database Connection (Option A: Individual Settings - common for cPanel, InfinityFree, VPS, Local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pocketpilot_db
DB_USER=root
DB_PASS=

# Database Connection (Option B: Single URL - common for Railway, Render, Heroku)
# If DATABASE_URL is set, it will automatically override individual DB_* settings above.
# DATABASE_URL=mysql://username:password@containers-us-west-1.railway.app:3306/railway
